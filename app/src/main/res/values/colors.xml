<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light mode. Ground is DiceGray (#B0BEC5); die faces are DiceRedDark (#D32F2F)
         multiplied by the three shading intensities the D6 renderer produces for this
         orientation (0.400, 0.602, 0.798). -->
    <color name="ic_launcher_background">#96A2A7</color>
    <color name="ic_launcher_background_gradient_start">#B0BEC5</color>

    <color name="ic_launcher_die_face_lit">#A82626</color>
    <color name="ic_launcher_die_face_mid">#7F1C1C</color>
    <color name="ic_launcher_die_face_shadow">#541313</color>

    <!-- Face edges and pips are white at the renderer's D6_STROKE_ALPHA (0.5) and
         D6_DOT_ALPHA (0.9) in both themes. -->
    <color name="ic_launcher_die_edge">#80FFFFFF</color>
    <color name="ic_launcher_pips">#E6FFFFFF</color>
</resources>
